{
  "expo": {
    "name": "RoutineLog",
    "slug": "routinelog-mobile",
    "version": "1.3.0",
    "icon": "./assets/branding/icon.png",
    "scheme": "routinelog",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0c0e10",
    "android": {
      "package": "pl.rados4y.routinelog",
      "versionCode": 4,
      "adaptiveIcon": {
        "foregroundImage": "./assets/branding/adaptive-icon.png",
        "backgroundColor": "#202124"
      }
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "name": "RoutineLog"
    }
  }
}
