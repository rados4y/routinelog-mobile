{
  "expo": {
    "name": "RoutineLog",
    "slug": "routinelog-mobile",
    "version": "1.2.0",
    "scheme": "routinelog",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0c0e10",
    "android": {
      "package": "pl.rados4y.routinelog",
      "versionCode": 3
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "name": "RoutineLog"
    }
  }
}
